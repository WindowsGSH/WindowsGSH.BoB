{
  "id": "beasts-of-bermuda",
  "name": "Beasts of Bermuda Dedicated Server",
  "version": "1.2.0",
  "author": "Shenniko",
  "description": "WindowsGSH module for installing, configuring, and running a Beasts of Bermuda dedicated server.",
  "url": "https://github.com/WindowsGSH/WindowsGSH.BoB",
  "homepage": "https://wiki.beastsofbermuda.com/Dedicated_Servers",
  "repository": "https://github.com/WindowsGSH/WindowsGSH.BoB",
  "sourceUrl": "https://github.com/WindowsGSH/WindowsGSH.BoB",
  "color": "#1E8449",
  "moduleApiVersion": "1.0",
  "minimumWindowsGshVersion": "0.1.0",
  "type": "csharp",
  "entry": "WindowsGSH.Modules.BeastsOfBermuda.BeastsOfBermudaModule",
  "steam": {
    "appId": "882430",
    "anonymous": true,
    "validate": true
  },
  "entryPoints": {
    "start": "BeastsOfBermuda\\Binaries\\Win64\\BeastsOfBermudaServer.exe",
    "processName": "BeastsOfBermudaServer"
  },
  "runtime": {
    "allowsEmbeddedConsole": true,
    "portIncrements": 1,
    "queryProtocol": "process",
    "defaultArguments": "-GameMode={server.gameMode} -MapName={quote:server.map} -SessionName={quote:server.name} -NumPlayers={server.maxPlayers} -MultiHome={quote:network.ip} -Port={network.port} -QueryPort={network.queryPort} -log {server.additionalArguments}",
    "stop": {
      "strategy": "closeWindow",
      "waitMilliseconds": 10000,
      "killAfterTimeout": true
    }
  },
  "capabilities": {
    "directConnection": true
  },
  "configFields": [
    {
      "key": "server.name",
      "label": "Server Name",
      "type": "Text",
      "defaultValue": "Beasts of Bermuda Server",
      "required": true,
      "group": "Server",
      "description": "Spaces are accepted by WindowsGSH quoting; keep the public name reasonably short."
    },
    {
      "key": "server.gameMode",
      "label": "Game Mode",
      "type": "Select",
      "defaultValue": "Life_Cycle",
      "required": true,
      "group": "Server",
      "options": [
        "Life_Cycle",
        "Combat",
        "Free_Roam"
      ]
    },
    {
      "key": "server.map",
      "label": "Map",
      "type": "Text",
      "defaultValue": "Forest_Island",
      "required": true,
      "group": "Server",
      "description": "Use the map's internal name, with underscores instead of spaces."
    },
    {
      "key": "server.maxPlayers",
      "label": "Max Players",
      "type": "Number",
      "defaultValue": 32,
      "minimum": 1,
      "maximum": 1000,
      "group": "Server"
    },
    {
      "key": "network.ip",
      "label": "Bind IP",
      "type": "Text",
      "defaultValue": "0.0.0.0",
      "group": "Network"
    },
    {
      "key": "network.port",
      "label": "Game Port",
      "type": "Port",
      "defaultValue": 7777,
      "required": true,
      "minimum": 1,
      "maximum": 65535,
      "group": "Network"
    },
    {
      "key": "network.queryPort",
      "label": "Steam Query Port",
      "type": "Port",
      "defaultValue": 27015,
      "required": true,
      "minimum": 1,
      "maximum": 65535,
      "group": "Network"
    },
    {
      "key": "server.additionalArguments",
      "label": "Additional Arguments",
      "type": "CommandLine",
      "defaultValue": "",
      "group": "Launch"
    },
    {
      "key": "gameplay.growthLimit",
      "label": "Growth Limit",
      "type": "Number",
      "defaultValue": 2,
      "minimum": 0.1,
      "maximum": 100,
      "group": "Gameplay"
    },
    {
      "key": "security.consoleLocked",
      "label": "Lock Console to Admins",
      "type": "Boolean",
      "defaultValue": true,
      "group": "Security",
      "description": "Keep enabled so ordinary players are not treated as administrators."
    }
  ],
  "ports": [
    {
      "id": "game-udp",
      "name": "Game Port (UDP)",
      "protocol": "udp",
      "configField": "network.port",
      "required": true
    },
    {
      "id": "game-tcp",
      "name": "Game Port (TCP)",
      "protocol": "tcp",
      "configField": "network.port",
      "required": true
    },
    {
      "id": "service-udp",
      "name": "Required Service Port (UDP)",
      "protocol": "udp",
      "fixedValue": 8888,
      "required": true
    },
    {
      "id": "service-tcp",
      "name": "Required Service Port (TCP)",
      "protocol": "tcp",
      "fixedValue": 8888,
      "required": true
    },
    {
      "id": "query-udp",
      "name": "Steam Query Port (UDP)",
      "protocol": "udp",
      "configField": "network.queryPort",
      "required": true
    },
    {
      "id": "query-tcp",
      "name": "Steam Query Port (TCP)",
      "protocol": "tcp",
      "configField": "network.queryPort",
      "required": true
    }
  ],
  "backupTargets": [
    {
      "key": "saved",
      "label": "Worlds, Configuration, and Logs",
      "path": "BeastsOfBermuda\\Saved",
      "type": "directory",
      "required": true
    }
  ],
  "addons": []
}
